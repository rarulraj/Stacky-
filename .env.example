# Set these in Vercel → Settings → Environment Variables (or .env.local for local).
# Users never enter an API key in the app.

# REQUIRED
OPENAI_API_KEY=sk-your-key-here

# RECOMMENDED
STACKY_OWNER_EMAIL=you@company.com
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL
OPENAI_RESEARCH_MODEL=gpt-4o
OPENAI_WEB_SEARCH=true
RESEND_API_KEY=
RESEND_FROM_EMAIL=Stacky <onboarding@resend.dev>
STACKY_LEAD_WEBHOOK_URL=
