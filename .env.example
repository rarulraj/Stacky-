# Copy to .env.local for local dev, or set in Vercel Project Settings for production.
# cp .env.example .env.local

# --- Required for AI (server-side — visitors do NOT need their own key) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESEARCH_MODEL=gpt-4o
OPENAI_WEB_SEARCH=true

# Hide in-app API key UI in production (users only give email)
NEXT_PUBLIC_SHOW_API_KEY_UI=true

# --- Lead capture (email gate — no accounts) ---
# You receive each visitor's email here when they start planning
STACKY_OWNER_EMAIL=you@company.com
# Optional: Slack / Zapier / Make webhook
STACKY_LEAD_WEBHOOK_URL=

# Optional: auto-email leads + outreach drafts
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=Stacky <outreach@yourdomain.com>
