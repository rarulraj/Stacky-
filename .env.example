# --- Vercel / production (set these in Vercel → Settings → Environment Variables) ---

# REQUIRED — powers AI questions, graph generation, expand
OPENAI_API_KEY=sk-your-key-here

# REQUIRED for production UX — hide per-user API key UI (server key only)
NEXT_PUBLIC_SHOW_API_KEY_UI=false

# RECOMMENDED — your inbox for visitor lead emails (needs RESEND_API_KEY to send)
STACKY_OWNER_EMAIL=you@company.com

# OPTIONAL model tuning
OPENAI_MODEL=gpt-4o-mini
OPENAI_RESEARCH_MODEL=gpt-4o
OPENAI_WEB_SEARCH=true

# OPTIONAL — email leads to STACKY_OWNER_EMAIL
RESEND_API_KEY=
RESEND_FROM_EMAIL=Stacky <onboarding@resend.dev>

# OPTIONAL — Slack / Zapier / Make webhook for leads
STACKY_LEAD_WEBHOOK_URL=
